# Optional. The defaults baked into docker-compose.yml are fine for a quick
# test on the VPS. Create a .env (cp .env.example .env) only if you want to
# override secrets or plug in real Eskiz / Telegram / Payme / Click credentials.

# ── Host port mapping ─────────────────────────────────────────────────────────
# FRONTEND_PORT=3000
# API_PORT=8080

# ── Database / cache / storage ────────────────────────────────────────────────
# POSTGRES_PASSWORD=change-me
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=change-me-min-8-chars
# MINIO_BUCKET=autotest-images

# ── App secrets ───────────────────────────────────────────────────────────────
# JWT_SECRET=change-me-jwt-secret-min-32-characters-long
# OTP_HMAC_SECRET=change-me-otp-hmac-secret

# ── Eskiz SMS (production OTP) ────────────────────────────────────────────────
# ESKIZ_EMAIL=
# ESKIZ_PASSWORD=

# ── Telegram login widget ─────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=

# ── Payme ─────────────────────────────────────────────────────────────────────
# PAYME_MERCHANT_ID=
# PAYME_SECRET_KEY=

# ── Click ─────────────────────────────────────────────────────────────────────
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
# CLICK_MERCHANT_USER_ID=
# CLICK_SECRET_KEY=
